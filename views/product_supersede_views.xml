<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action for Supersession Management -->
    <record id="action_product_supersede" model="ir.actions.act_window">
        <field name="name">Product Supersessions</field>
        <field name="res_model">product.supersede</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create and manage product supersession / replacement relationships.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_product_supersede_main"
              name="Supersession Management"
              parent="stock.menu_stock_warehouse_mgmt"
              sequence="100"/>

    <menuitem id="menu_product_supersede"
              name="Product Supersessions"
              parent="menu_product_supersede_main"
              action="action_product_supersede"
              sequence="10"/>

    <!-- Action for creating supersession from product form -->
    <record id="action_create_supersession" model="ir.actions.act_window">
        <field name="name">Create Supersession</field>
        <field name="res_model">product.supersede</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_product_id': active_id}</field>
    </record>

    <!-- Tree View -->
    <record id="view_product_supersede_tree" model="ir.ui.view">
        <field name="name">product.supersede.tree</field>
        <field name="model">product.supersede</field>
        <field name="arch" type="xml">
            <tree string="Supersession Relationships" default_order="sequence, id">
                <field name="sequence" widget="handle"/>
                <field name="display_name"/>
                <field name="relationship_type"/>
                <field name="product_id"/>
                <field name="related_product_id"/>
                <field name="state"/>
                <field name="active" widget="boolean"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_product_supersede_form" model="ir.ui.view">
        <field name="name">product.supersede.form</field>
        <field name="model">product.supersede</field>
        <field name="arch" type="xml">
            <form string="Supersession Relationship">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="related_product_id"/>
                            <field name="relationship_type"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="effective_date"/>
                            <field name="expiration_date"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Reason / notes..." colspan="2"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_product_supersede_search" model="ir.ui.view">
        <field name="name">product.supersede.search</field>
        <field name="model">product.supersede</field>
        <field name="arch" type="xml">
            <search string="Search Supersession">
                <field name="display_name"/>
                <field name="product_id"/>
                <field name="related_product_id"/>
                <field name="relationship_type"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <filter string="Current" name="current" domain="[('state','=','active')]"/>
                <filter string="Future" name="future" domain="[('state','=','future')]"/>
                <filter string="Expired" name="expired" domain="[('state','=','expired')]"/>
                <group expand="0" string="Group By">
                    <filter string="Main Product" name="group_product" context="{'group_by':'product_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by':'relationship_type'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
